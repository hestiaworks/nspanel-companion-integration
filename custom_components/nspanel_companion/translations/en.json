  },
  "services": {
    "notify": {
      "name": "Notify panels",
      "description": "Shows a notification on the targeted panels that are connected now. Nothing is queued for a panel that is offline.",
      "fields": {
        "message": {
          "name": "Message",
          "description": "What the notification says."
        },
        "title": {
          "name": "Title",
          "description": "A short heading above the message."
        },
        "importance": {
          "name": "Importance",
          "description": "Important notifications open a sheet over the page and always play their sound, even during do not disturb."
        },
        "sound": {
          "name": "Sound",
          "description": "Overrides the panel's sound for this notification only."
        },
        "duration": {
          "name": "Banner duration",
          "description": "How long a normal notification's banner stays, for this notification only. The panel's setting otherwise."
        },
        "repeat_every": {
          "name": "Repeat sound",
          "description": "How often it comes back while unread (a regular one) or unanswered (an important one), for this notification only."
        },
        "repeat_times": {
          "name": "Stop repeating after",
          "description": "How many times it rings again, or until it is answered."
        }
      }
    }
  },
  "selector": {
    "importance": {
      "options": {
        "normal": "Normal",
        "important": "Important"
      }
    },
    "sound": {
      "options": {
        "off": "Silent",
        "notify_soft": "Soft",
